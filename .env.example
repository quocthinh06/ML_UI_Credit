# Optional server-side MongoDB Atlas connection. Keep real credentials out of Git.
MONGODB_URI=
MONGODB_DATABASE=creditrisk_ai
# Enable only after configuring the three secrets below and MongoDB Atlas.
AUTH_ENABLED=0
SESSION_SECRET=
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=

# Optional raw database credentials: set BOTH to override URI credentials.
# Useful when the password has @, /, %, etc. Do not percent-encode these values.
# This database user is separate from INITIAL_ADMIN_USERNAME (the web account).
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_AUTH_SOURCE=admin

# Optional server-only Groq commentary. Never commit a real key.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
