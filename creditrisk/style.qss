QWidget { font-family: 'Segoe UI'; font-size: 13px; color: #182338; }
QMainWindow, QWidget#content { background: #f7f8fc; }
QWidget#profileForm { background: #f7f8fc; }
QFrame#sidebar { background: #0c1929; border: none; }
QFrame#sidebar QLabel { color: #bdcadd; }
QFrame#sidebar QLabel#brand { color: white; font-size: 23px; font-weight: 700; }
QFrame#sidebar QPushButton { text-align: left; background: transparent; color: #c4d0e0; border: none; padding: 14px 16px; }
QFrame#sidebar QPushButton:checked { background: #2460e8; color: white; }
QLabel#title { font-size: 26px; font-weight: 700; }
QLabel#subtitle { color: #56657b; }
QLabel#metric { font-size: 28px; font-weight: 700; }
QLabel#result { font-size: 34px; font-weight: 700; }
QGroupBox { background: white; border: 1px solid #dce3ee; border-radius: 9px; margin-top: 15px; padding: 18px 14px 12px; font-weight: 600; }
QGroupBox::title { subcontrol-origin: margin; left: 15px; padding: 0 5px; }
QPushButton { background: #2460e8; color: white; border: 1px solid #2460e8; border-radius: 6px; padding: 9px 14px; font-weight: 600; }
QPushButton:hover { background: #174ac4; }
QPushButton:pressed { background: #123a9e; }
QPushButton:disabled { background: #e0e6ef; border-color: #d0d8e5; color: #58677e; }
QPushButton[secondary="true"] { background: white; border-color: #b9c7d9; color: #184a8c; }
QPushButton[secondary="true"]:hover { background: #edf3ff; }
QPushButton:focus, QLineEdit:focus, QDoubleSpinBox:focus, QComboBox:focus, QTableView:focus { border: 2px solid #1764d8; }
QLineEdit, QDoubleSpinBox, QSpinBox, QComboBox { border: 1px solid #b9c7d9; border-radius: 5px; background: white; padding: 6px; min-height: 22px; }
QTableView { background: white; alternate-background-color: #f4f7fc; border: 1px solid #dce3ee; gridline-color: #e4eaf3; selection-background-color: #dce9ff; selection-color: #182338; }
QHeaderView::section { background: #eef2fa; padding: 9px; border: none; border-bottom: 1px solid #dce3ee; font-weight: 600; }
QTabWidget::pane { border: none; }
QTabBar::tab { background: #e9eefb; padding: 12px 20px; color: #445976; }
QTabBar::tab:selected { background: white; color: #1457bf; }
QScrollArea { border: none; background: transparent; }
QProgressBar { border: none; background: #e5ebf6; border-radius: 4px; text-align: center; }
QProgressBar::chunk { background: #2460e8; border-radius: 4px; }
QStatusBar { background: white; color: #445976; }
